ers/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"19e01264cf843082c6241805cfe2e06e55988337","url":"https://api.github.com/repos/PaloAltoNetworks/Unit42-timely-threat-intel/commits/19e01264cf843082c6241805cfe2e06e55988337","html_url":"https://github.com/PaloAltoNetworks/Unit42-timely-threat-intel/commit/19e01264cf843082c6241805cfe2e06e55988337"}],"stats":{"total":7,"additions":4,"deletions":3},"files":[{"sha":"1b70a6b2f5f4c6ce82f02e706763ab359b02a90e","filename":"2026-09-14-Regional-News-Outlet-Infected-With-Malicious-JavaScript.txt","status":"modified","additions":4,"deletions":3,"changes":7,"blob_url":"https://github.com/PaloAltoNetworks/Unit42-timely-threat-intel/blob/388d2126a51559b0edd61197b5bfcb9460663483/2026-09-14-Regional-News-Outlet-Infected-With-Malicious-JavaScript.txt","raw_url":"https://github.com/PaloAltoNetworks/Unit42-timely-threat-intel/raw/388d2126a51559b0edd61197b5bfcb9460663483/2026-09-14-Regional-News-Outlet-Infected-With-Malicious-JavaScript.txt","contents_url":"https://api.github.com/repos/PaloAltoNetworks/Unit42-timely-threat-intel/contents/2026-09-14-Regional-News-Outlet-Infected-With-Malicious-JavaScript.txt?ref=388d2126a51559b0edd61197b5bfcb9460663483","patch":"@@ -1,4 +1,4 @@\n-2026-09-14 (MONDAY): Regional News Outlet Infected with Malicious JavaScript Delivering ClickFix Prompts Delivering Encrypted Stealc InfoStealer\r\n+2026-09-14 (MONDAY): Regional News Outlet Infected with Malicious JavaScript Delivering ClickFix Prompts Delivering Encrypted Malware\r\n \r\n AUTHORS:\r\n \r\n@@ -12,7 +12,7 @@ REFERENCES:\n NOTES:\r\n \r\n - An independent regional news outlet has been compromised with malicious JavaScript delivering ClickFix social engineering prompts.\r\n-- The final payload is an encrypted, compressed, and then ConfuserEx-encrypted Stealc binary.\r\n+- The final payload is an encrypted, compressed, and then ConfuserEx-encrypted binary.\r\n \r\n DETAILS:\r\n \r\n@@ -21,7 +21,8 @@ DETAILS:\n - The JavaScript checks for a specific cookie (cookie-captcha-complete). If absent, it serves the ClickFix overlay and sets the cookie to prevent repeat execution.\r\n - The ClickFix social engineering overlay tricks the user into copying and running an obfuscated command via the Windows Run dialog (cmd.exe /c ...).\r\n - This command downloads a PowerShell script (configuration.ps1) from mnl[.]ac (149.255.35[.]135) and executes it by dynamically calling PowerShell (^W^h^E^r^E po*r*e*l.*e) and bypassing the execution policy.\r\n-- The configuration.ps1 script contains an encrypted, gzip-compressed payload that unpacks the stage 2 Stealc binary loaded into memory.\r\n+- The configuration.ps1 script contains an encrypted, gzip-compressed payload that unpacks the stage 2 binary loaded into memory.\r\n+- While we have some indicators that StealC is assocaited with this infection chain, we have not yet confirmed.\r\n \r\n Payload Analysis: Execution and Core Capabilities\r\n \r"}]}