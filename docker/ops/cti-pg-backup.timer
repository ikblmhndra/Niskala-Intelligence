# Jadwal backup harian (lihat cti-pg-backup.service). Persistent=true: kalau host mati saat jadwal,
# backup dijalankan begitu host hidup lagi.
[Unit]
Description=CTI platform - backup Postgres harian

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
