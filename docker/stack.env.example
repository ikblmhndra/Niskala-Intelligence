# Variabel level COMPOSE -- dipakai interpolasi ${...} di docker-compose.yml.
# BUKAN env aplikasi: JANGAN digabung ke .env (pydantic-settings extra="forbid"
# nolak key yang gak dikenal, proses gagal start).
#
#   cp docker/stack.env.example docker/stack.env        # docker/stack.env di-gitignore
#   docker compose --env-file .env --env-file docker/stack.env --profile app up -d --build

# Nyalain stack penuh tanpa nulis --profile app tiap kali.
COMPOSE_PROFILES=app

# Interface tempat api/web di-publish (buat debug dari host). Akses luar lewat service `nginx`
# (di bawah), jadi biarkan 127.0.0.1. Pakai nginx di host LAIN -> IP interface internal
# (atau 0.0.0.0 + firewall).
BIND_ADDR=127.0.0.1
API_PORT=8000
WEB_PORT=3000

# --- nginx (edge: TLS + reverse proxy ke web; satu-satunya yang dibuka ke luar) ------------
# Interface + port. Sudah ada nginx lain di host yang memakai 80/443? Ganti port di sini.
NGINX_BIND_ADDR=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Nama host / IPv4 yang dipakai orang untuk membuka platform ini, dipisah koma. Masuk ke SAN
# sertifikat self-signed (`localhost` + `127.0.0.1` selalu ada). Kurang/salah = browser
# menampilkan "nama tidak cocok" SELAIN peringatan self-signed. Berubah = sertifikat dibuat ulang.
NGINX_TLS_HOSTS=cti.example.internal,10.0.0.5
# Masa berlaku sertifikat self-signed baru (hari). Diperbarui otomatis saat container start dan
# sisanya <= 30 hari (restart nginx kira-kira tiap rilis sudah cukup).
NGINX_TLS_DAYS=365
# Pakai sertifikat SENDIRI (CA internal)? Taruh cti.crt + cti.key di direktori ini; generator
# self-signed tidak akan menyentuhnya. Isi direktori ini di-gitignore (ada kunci privat).
NGINX_TLS_DIR=./docker/nginx/tls

# Password Postgres HARUS sama dgn yang ada di DATABASE__URL / DATABASE__SYNC_URL
# di .env (user:password@postgres:5432/db). Default dev = cti/cti; GANTI di prod.
POSTGRES_USER=cti
POSTGRES_PASSWORD=cti
POSTGRES_DB=cti

# Tag image (mis. git sha). ROLLBACK JANGAN cuma ganti tag + `up -d`: kalau DB sudah di revisi migrasi
# yang lebih baru dari image lama, service `migrate` gagal DAN api/worker yang sedang jalan ikut
# terhenti (outage; terbukti di latihan staging). Pakai `python3 tools/ops/rollback.py` -- lihat
# docs/CUTOVER_RUNBOOK.md bagian Rollback.
CTI_TAG=latest

# Concurrency. Worker NLP dibatasi RAM: tiap proses child load model spaCy.
WORKER_CONCURRENCY=4
BROWSER_WORKER_CONCURRENCY=2
NLP_WORKER_CONCURRENCY=2

# Jumlah proxy TERPERCAYA di depan web (nginx saja = 1). Menentukan IP klien
# mana yang dipakai rate limit login + audit log (apps/web/src/lib/auth/client-ip.ts).
TRUSTED_PROXY_HOPS=1
