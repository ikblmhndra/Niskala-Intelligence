"""{{ source }} -- hasil migrasi otomatis dari `ScraperNews/{{ legacy_script }}.py`
(codemod Fase 4, family XPath runtime="{{ runtime }}"). Cek
`migration_report.json` buat detail ekstraksi. WAJIB lewat `dry-run` +
`verify` sebelum `enable` -- lihat docs/ADDING_A_SCRAPER.md.
"""

from __future__ import annotations

from cti_scraper.base import ScraperMeta
from cti_scraper.families.xpath import XPathScraper
from cti_scraper.schedule import spread


class {{ class_name }}(XPathScraper):
    meta = ScraperMeta(
        id="{{ scraper_id }}",
        source="{{ source }}",
        schedule=spread("{{ schedule }}", "{{ scraper_id }}"),
        runtime="{{ runtime }}",
{% if runtime == "browser" %}
        rate_limit="6/minute",
{% endif %}
        max_items={{ max_items }},
        tags=("migrated",),
{% if legacy_label %}
        legacy_label="{{ legacy_label }}",
{% endif %}
        legacy_script="{{ legacy_script }}",
    )
    url = {{ url_repr }}
    title_xpath = {{ title_xpath_repr }}
    link_xpath = {{ link_xpath_repr }}
{% if base_url %}
    base_url = "{{ base_url }}"
{% endif %}
