"""{{ source }} -- hasil migrasi otomatis dari `ScraperNews/{{ legacy_script }}.py`
(codemod Fase 4, family RSS). Cek `migration_report.json` buat detail
ekstraksi. WAJIB lewat `dry-run` + `verify` sebelum `enable` -- lihat
docs/ADDING_A_SCRAPER.md.
"""

from __future__ import annotations

from cti_scraper.base import ScraperMeta
from cti_scraper.families.rss import RSSScraper
from cti_scraper.schedule import spread


class {{ class_name }}(RSSScraper):
    meta = ScraperMeta(
        id="{{ scraper_id }}",
        source="{{ source }}",
        schedule=spread("{{ schedule }}", "{{ scraper_id }}"),
        tags=("migrated",),
{% if legacy_label %}
        legacy_label="{{ legacy_label }}",
{% endif %}
        legacy_script="{{ legacy_script }}",
    )
    feeds = ({{ feeds_repr }},)
{% if item_path != ".//item" %}
    item_path = "{{ item_path }}"
{% endif %}
{% if title_path != "title" %}
    title_path = "{{ title_path }}"
{% endif %}
{% if link_path != "link" %}
    link_path = "{{ link_path }}"
{% endif %}
{% if date_path is none %}
    date_path = None  # scraper lama pakai waktu-scrape, bukan tanggal artikel asli
{% else %}
    date_path = "{{ date_path }}"
{% endif %}
{% if xml_fixups %}
    xml_fixups = ({{ xml_fixups_repr }},)
{% endif %}
{% if html_unescape %}
    html_unescape = True  # feed lama pakai html.unescape() sebelum parse XML
{% endif %}
